# Portable shell aliases and functions, shared with the dev container.
# Sourced from ~/.zshrc on the host; mounted into the container by the meta-repo
# (see `dotfiles` in meta-repo.local.yaml). Keep it free of host-specific
# paths and secrets.

export EDITOR=nano
export VISUAL="$EDITOR"




alias gbl="git branch --list"
alias nrd="npm run dev"
alias gpf="git push --force-with-lease"
alias coffee="caffeinate -dis"
alias sourcez="source ~/.zshrc && source ~/.zshenv"
alias dps="docker ps"

# Open a shell in a running container: `dssh 1` (nth row of `dps`) or `dssh <container id/name>`.
dssh() {
  local target=$1
  if [ -z "$target" ]; then
    echo "usage: dssh <n | container id | name>" >&2
    return 1
  fi
  if [[ "$target" =~ ^[0-9]+$ ]] && [ "$target" -le 999 ]; then
    local id
    id=$(docker ps -q | sed -n "${target}p")
    if [ -z "$id" ]; then
      echo "dssh: no running container #$target" >&2
      return 1
    fi
    target=$id
  fi
  docker exec -it "$target" bash 2>/dev/null || docker exec -it "$target" sh
}

# Check out a branch and hard-reset it to origin (asks first if there are
# uncommitted changes).
_git_reset_to_origin() {
  local branch=$1
  git checkout "$branch" || return 1
  git fetch origin

  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "⚠️  Uncommitted changes on $branch:"
    git status --short
    echo -n "Reset to origin/$branch anyway? [y/N] "
    read ans
    [[ "$ans" =~ ^[Yy]$ ]] || return 1
  fi

  git reset --hard "origin/$branch"
}

grm() { _git_reset_to_origin main; }
grmm() { _git_reset_to_origin master; }


